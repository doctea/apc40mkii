  "version": "0.1.1",
  "description": "APC40 MkII controller and portable MIDI core",
  "keywords": [
    "midi",
    "controller",
    "akai",
    "apc40"
  ],
  "frameworks": "arduino",
  "platforms": "teensy",
  "build": {
